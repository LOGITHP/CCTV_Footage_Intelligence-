# Multi-Stream Video Intelligence - Environment Configuration Template

# Database: Supabase Cloud PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_PATH=data/video_intelligence.sqlite3

# Local MinIO Object Storage (Original Videos & Evidence Clips)
OBJECT_STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=video-intelligence
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword123
S3_REGION=us-east-1

# LLM Reasoning: Meta Muse Spark Open via Baseten Hackathon Inference ($100 credit + 2M TPM)
BASETEN_API_KEY=b10_nVtchD9y.qWy7Pmz8Glauaka2Z1A4Tlrwr4dQy5gL
BASETEN_INFERENCE_URL=https://inference.baseten.co/v1
META_MODEL=meta-models/muse-spark-open-1026
CHAT_MODEL_MODE=template

# Object Detection & Segmentation: Meta SAM 3.1 via Meta Direct API
META_API_KEY=LLM_953135614536411_MGNsLLKsiV1PptUKrlzmzf9cLMg
META_API_URL=https://api.meta.ai/v1
MODEL_PROFILE=sam
TRACKER_PROFILE=sam
SAM_MODEL=models/sam/sam3.1.pt

# Embeddings: SigLIP 2 (Visual) & BGE-M3 (Text) inside Docker container
SIGLIP_MODEL=google/siglip2-base-patch16-224
BGE_MODEL=BAAI/bge-m3
BASETEN_SIGLIP_ENDPOINT=
BASETEN_BGE_ENDPOINT=

# Qdrant Cloud Vector Storage
QDRANT_URL=https://6b0d33bb-ed40-4932-b576-d73fb0d8bce0.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NzgyNWY1ZTItZjRiNi00ZjEzLTk2YmQtYjA1MDIwOGYwMDZiIn0._Wq5qyrC0AeFJwAZieBzQsz_baWyA3vdNEX3hwTsiaA
QDRANT_COLLECTION=video-events

# JWT Authentication & RBAC
AUTH_REQUIRED=false
JWT_SECRET=meta_hackathon_super_secret_jwt_key_at_least_32_bytes_long!
JWT_TOKEN_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Media Storage Root
MEDIA_ROOT=data/media
AUTH_DATABASE_PATH=data/auth.sqlite3
AUDIT_DATABASE_PATH=data/auth.sqlite3
